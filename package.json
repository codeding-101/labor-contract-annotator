{
  "name": "labor-contract-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地化、开源的劳动合同风险检查工具：官方范本比对 + 规则引擎，文件不离开设备",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:statutes": "node src/build-statutes.ts",
    "build:templates": "node src/build-templates.ts",
    "build:cases": "node src/build-cases.ts",
    "validate:data": "node src/validate-data.ts",
    "diff:sources": "node src/diff-sources.ts",
    "eval:diff": "node src/eval-diff.ts",
    "report:sample": "node src/report-sample.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build:statutes && npm run build:templates && npm run build:cases && npm run validate:data && npm run eval:diff"
  },
  "dependencies": {
    "word-extractor": "^1.0.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
